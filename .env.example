# Telegram — api_id/hash: https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# @BotFather → /newbot. Add the bot to the channel as admin with
# "Post", "Edit" and "Delete messages" rights.
TG_BOT_TOKEN=
# Private channel id, e.g. -1001234567890 (forward a post to @userinfobot or @RawDataBot)
TG_CHANNEL_ID=

# Optional — leave blank to disable
TMDB_API_KEY=
JELLYFIN_URL=http://jellyfin.homelab.svc.cluster.local:8096
JELLYFIN_API_KEY=
HOMELERT_WEBHOOK_URL=http://homelert.homelert.svc.cluster.local/webhook/tg-jellyfin-sync

# Local run: point these at a scratch folder instead of the real HDD
MOVIES_DIR=./local/movies
TV_DIR=./local/tvshows
UNSORTED_DIR=./local/unsorted
STAGING_DIR=./local/staging
STATE_DIR=./local/state

DELETE_AFTER_IMPORT=true
# 2 GiB — Telegram's non-Premium limit
MAX_FILE_SIZE=2147483648
